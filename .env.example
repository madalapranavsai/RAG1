# ==========================================
# DocuMind Python Full-stack Configuration
# ==========================================

# Application Settings
APP_NAME="DocuMind RAG"
PORT=8000
HOST="0.0.0.0"

# Supabase (Free Tier: https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API (Free Tier: https://aistudio.google.com)
GOOGLE_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-1.5-flash

# Embeddings Engine
# 'local' uses FastEmbed MiniLM (384 dimensions, 100% free, in-memory)
# 'gemini' uses Google text-embedding-004
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
